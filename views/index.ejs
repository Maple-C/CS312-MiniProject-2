<!DOCTYPE html>

<html> 
    <head>
        <meta charset="UTF-8"> 

        <link rel="stylesheet" href="/styles.css" >


        <title> Cocktail Recipe Finder </title>

    </head>
    <body>
        <h1> Cocktail Recipe Finder </h1>
        <form action="search" method ="POST"">
            <input type="text" name ="name" placeholder="What Cocktail do you want to search for?">
            <button type="submit">Search!</button>
        </form>
    </body> 


<% if (error) { %>
<p class="error"><%= error %></p>
<% } %>

<% if (drink) { %>
    <div>
        <h2>
            <%= drink.strDrink %>
        </h2>
        <img src="<%= drink.strDrinkThumb %>/medium" alt="
        


        <%= drink.strDrink %> ">
        <p>
            <%= drink.strInstructions %>
        </p>
    </div>
<%  } %> 
 

</html>

